# Go CI — required check: "Go Server Build (<component>)"
# Uses matrix.include to avoid cartesian product. 7 components: 3 server + 4 shared.
# paths-ignore ensures the workflow always triggers on PRs (required check needs a conclusion).
# dorny/paths-filter detects per-component changes; skips build if none but outputs success.
name: Go CI

on:
  pull_request:
    branches: [main, dev]
    types: [opened, synchronize, reopened]
    paths-ignore:
      - '**/*.md'
      - 'docs/**'
      - 'LICENSE'
      - '.gitignore'
      - '.gitattributes'
      - '.commitlintrc.json'
      - '.editorconfig'
      - 'android/**'
  push:
    branches: [main, dev]
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read
      pull-requests: read

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: 'true'

jobs:
  go:
    name: Go Server Build (${{ matrix.component }})
    runs-on: [self-hosted, Linux, X64, do-sfo3]
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: read
      actions: write
    strategy:
      fail-fast: false
      matrix:
        include:
          - component: api
            path: server/api
          - component: socks5-proxy
            path: server/socks5-proxy
          - component: tunnel
            path: server/tunnel
          - component: httpclient
            path: server/shared/httpclient
          - component: ratelimit
            path: server/shared/ratelimit
          - component: recovery
            path: server/shared/recovery
          - component: stringutil
            path: server/shared/stringutil
    env:
      # Cache isolation per component (persistent self-hosted runner)
      GOMODCACHE: /tmp/go-mod-${{ matrix.component }}
      GOCACHE: /tmp/go-build-${{ matrix.component }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v5

      - name: Detect changes
        id: filter
        uses: dorny/paths-filter@v3
        with:
          filters: |
            component:
              - '${{ matrix.path }}/**'
              - 'Makefile'
              - '.github/workflows/go-ci.yml'

      - name: Set up Go
        if: steps.filter.outputs.component == 'true'
        uses: actions/setup-go@v5
        with:
          go-version-file: ${{ matrix.path }}/go.mod
          cache: false

      - name: Cache Go modules and build cache
        if: steps.filter.outputs.component == 'true'
        uses: actions/cache@v4
        with:
          path: |
            /tmp/go-mod-${{ matrix.component }}
            /tmp/go-build-${{ matrix.component }}
          key: ${{ runner.os }}-go-${{ matrix.component }}-${{ hashFiles(format('{0}/go.sum', matrix.path), format('{0}/go.mod', matrix.path)) }}
          restore-keys: |
            ${{ runner.os }}-go-${{ matrix.component }}-

      - name: Check gcc availability
        if: steps.filter.outputs.component == 'true'
        id: gcc
        run: |
          if command -v gcc &>/dev/null; then
            echo "available=true" >> "$GITHUB_OUTPUT"
          else
            echo "available=false" >> "$GITHUB_OUTPUT"
          fi

      # Step 7.1: Unified Makefile call — build + test + gofmt + vet + mod-tidy-check
      - name: CI checks for ${{ matrix.component }}
        if: steps.filter.outputs.component == 'true'
        env:
          CGO_ENABLED: ${{ steps.gcc.outputs.available == 'true' && '1' || '0' }}
        run: make go-ci-component COMPONENT=${{ matrix.component }}
        continue-on-error: true  # quality checks (fmt/vet/tidy) still collecting baseline

      - name: Upload coverage report
        uses: actions/upload-artifact@v4
        if: always() && steps.filter.outputs.component == 'true'
        with:
          name: go-coverage-${{ matrix.component }}
          path: ${{ matrix.path }}/coverage.out

      - name: Install govulncheck
        if: always() && steps.filter.outputs.component == 'true'
        run: go install golang.org/x/vuln/cmd/govulncheck@latest

      - name: Run vulnerability check
        if: always() && steps.filter.outputs.component == 'true'
        working-directory: ${{ matrix.path }}
        run: govulncheck ./...
        continue-on-error: true

      - name: No changes for ${{ matrix.component }} — skip
        if: steps.filter.outputs.component == 'false'
        run: echo "No changes for ${{ matrix.component }}, skipping build & test."

      # Per-job cleanup: only remove build cache (GOCACHE), keep module cache (GOMODCACHE)
      - name: Cleanup build cache
        if: always()
        run: rm -rf "$GOCACHE" 2>/dev/null || true
