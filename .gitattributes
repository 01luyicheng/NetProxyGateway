# Normalize line endings for Kotlin/Android source files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf

# Go source files
*.go text eol=lf

# Shell scripts must use LF
*.sh text eol=lf

# Config and documentation files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf

# Windows-specific files should use CRLF
*.bat text eol=crlf

# Binary files - no normalization
*.png binary
*.jpg binary
*.jar binary
*.keystore binary
