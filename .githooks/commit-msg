#!/bin/sh
#
# Commit message hook for NetProxyGateway
# Validates commit message format follows Conventional Commits
#

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Conventional Commits pattern
# Format: type(scope): description or type: description
# Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z-]+\))?: .{1,}"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo "${RED}Invalid commit message format.${NC}"
    echo ""
    echo "Commit message must follow Conventional Commits specification:"
    echo "  ${YELLOW}<type>[(<scope>)]: <description>${NC}"
    echo ""
    echo "Valid types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo ""
    echo "Examples:"
    echo "  ${YELLOW}feat: add user authentication${NC}"
    echo "  ${YELLOW}fix(android): resolve memory leak in VPN service${NC}"
    echo "  ${YELLOW}docs: update README with setup instructions${NC}"
    echo ""
    exit 1
fi

# Check line length (max 100 characters for subject)
SUBJECT_LINE=$(echo "$COMMIT_MSG" | head -n 1)
if [ ${#SUBJECT_LINE} -gt 100 ]; then
    echo "${RED}Commit message subject is too long (${#SUBJECT_LINE} > 100 characters).${NC}"
    exit 1
fi

exit 0
