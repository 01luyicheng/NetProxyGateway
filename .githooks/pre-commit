#!/bin/sh
#
# Pre-commit hook for NetProxyGateway
# Runs unit tests before allowing commits
#

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if we're in the right directory (support both Unix and Windows)
if [ ! -f "android/gradlew" ] && [ ! -f "android/gradlew.bat" ]; then
    echo "${RED}Error: android/gradlew or android/gradlew.bat not found. Are you in the project root?${NC}"
    exit 1
fi

# Run Android unit tests
echo "${YELLOW}Running Android unit tests...${NC}"

# Detect OS and use appropriate gradle wrapper
if [ "$OS" = "Windows_NT" ] || [ -n "$WINDIR" ]; then
    # Windows environment
    android/gradlew.bat -p android :app:testDebugUnitTest --stacktrace --no-daemon
else
    # Unix-like environment
    ./android/gradlew -p android :app:testDebugUnitTest --stacktrace --no-daemon
fi

# Check test result
if [ $? -ne 0 ]; then
    echo "${RED}Unit tests failed. Commit aborted.${NC}"
    echo "${YELLOW}Please fix the tests before committing.${NC}"
    exit 1
fi

echo "${GREEN}All checks passed! Proceeding with commit.${NC}"
exit 0
