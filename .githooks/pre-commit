#!/bin/sh
#
# Pre-commit hook for NetProxyGateway
# Runs unit tests before allowing commits
#

echo "Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if we're in the right directory
if [ ! -f "android/gradlew" ]; then
    echo "${RED}Error: android/gradlew not found. Are you in the project root?${NC}"
    exit 1
fi

# Run Android unit tests
echo "${YELLOW}Running Android unit tests...${NC}"
./android/gradlew.bat -p android :app:testDebugUnitTest --stacktrace --no-daemon

# Check test result
if [ $? -ne 0 ]; then
    echo "${RED}Unit tests failed. Commit aborted.${NC}"
    echo "${YELLOW}Please fix the tests before committing.${NC}"
    exit 1
fi

echo "${GREEN}All checks passed! Proceeding with commit.${NC}"
exit 0
